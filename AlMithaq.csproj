<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>AlMithaq</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>AlMithaq</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.almithaq</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.1.5</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
	  <ApplicationId>com.companyname.almithaq</ApplicationId>
	  <ApplicationVersion>3</ApplicationVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-ios|AnyCPU'">
	  <ApplicationId>com.companyname.almithaq</ApplicationId>
	  <ApplicationVersion>3</ApplicationVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-maccatalyst|AnyCPU'">
	  <ApplicationId>com.companyname.almithaq</ApplicationId>
	  <ApplicationVersion>3</ApplicationVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-windows10.0.19041.0|AnyCPU'">
	  <ApplicationId>com.companyname.almithaq</ApplicationId>
	  <ApplicationVersion>3</ApplicationVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
	  <ApplicationId>com.companyname.almithaq</ApplicationId>
	  <ApplicationVersion>9</ApplicationVersion>
	  <AndroidPackageFormats>aab;apk</AndroidPackageFormats>
	  <AndroidLinkTool>r8</AndroidLinkTool>
	  <AndroidR8ObfuscationMode>private-members</AndroidR8ObfuscationMode>
      <AndroidBundleConfigurationFile>Properties\AndroidBundleConfig.json</AndroidBundleConfigurationFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-ios|AnyCPU'">
	  <ApplicationId>com.companyname.almithaq</ApplicationId>
	  <ApplicationVersion>3</ApplicationVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-maccatalyst|AnyCPU'">
	  <ApplicationId>com.companyname.almithaq</ApplicationId>
	  <ApplicationVersion>3</ApplicationVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-windows10.0.19041.0|AnyCPU'">
	  <ApplicationId>com.companyname.almithaq</ApplicationId>
	  <ApplicationVersion>3</ApplicationVersion>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!-- Per-assembly DSOs avoid the Mono assembly-store startup hang observed on Android x64. -->
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<AndroidUseAssemblyStore>false</AndroidUseAssemblyStore>
		<AndroidEnableAssemblyCompression>false</AndroidEnableAssemblyCompression>
		<!-- Release libmonodroid requires compression metadata even without assembly stores (.NET Android #13247). -->
		<AndroidEnableAssemblyCompression Condition="'$(Configuration)' == 'Release'">true</AndroidEnableAssemblyCompression>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<ApplicationId>com.companyname.almithaq.dev</ApplicationId>
		<ApplicationTitle>الميثاق — تجربة</ApplicationTitle>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and Exists('$(MSBuildProjectDirectory)\.local\debug.keystore')">
		<!-- Local development key only. Release signing remains separately configured. -->
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(MSBuildProjectDirectory)\.local\debug.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>androiddebugkey</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>android</AndroidSigningKeyPass>
		<AndroidSigningStorePass>android</AndroidSigningStorePass>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\mithaqmark.svg" Color="#123F34" ForegroundScale="0.8" />

		<!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\mithaqsplash.svg" Color="#123F34" BaseSize="160,160" />
		
		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\home_welcome.svg" BaseSize="360,137" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />
        <MauiFont Remove="Resources\Fonts\OpenSans-Semibold.ttf;Resources\Fonts\Font Awesome 6 Brands-Regular-400.otf;Resources\Fonts\Font Awesome 6 Free-Regular-400.otf" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<BundleResource Include="Platforms/Android/Resources/raw/adhan_ali_mulla.mp3;Platforms/Android/Resources/raw/adhan_haddad.m4a;Platforms/Android/Resources/raw/salawat_reminder.m4a" LogicalName="%(Filename)%(Extension)" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
        <BundleResource Include="Platforms/iOS/Resources/*_notice.caf" LogicalName="%(Filename)%(Extension)" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
        <MauiAsset Remove="Resources\Raw\mushaf\pages\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Resources\Splash\splash.svg" />
	</ItemGroup>

	<ItemGroup>
		
		<PackageReference Include="Adhan" Version="0.9.0" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
		<PackageReference Include="Xamarin.Google.Android.Play.App.Update" Version="2.1.0.9" Condition="'$(TargetFramework)' == 'net10.0-android'" />
		<PackageReference Include="CommunityToolkit.Maui" Version="14.0.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.60" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.3" />
	</ItemGroup>

	<ItemGroup>


	  <Folder Include="Resources\Images\" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Resources\Data\surah.json" />
	  <EmbeddedResource Include="Resources\Raw\quran.json" LogicalName="AlMithaq.Data.quran.json" />
	  <EmbeddedResource Include="Resources\Raw\azkar.json" LogicalName="AlMithaq.Data.azkar.json" />
      <EmbeddedResource Include="Resources\Raw\hisn.json" LogicalName="AlMithaq.Data.hisn.json" />
	  <MauiAsset Remove="Resources\Raw\quran.json;Resources\Raw\azkar.json;Resources\Raw\hisn.json" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Shared\Controls\CustomControl.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Azkar\Views\AzkarPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Home\Views\HomePage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\PrayerTimes\Views\PrayerTimesPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Qibla\Views\QiblaPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Quran\Views\QuranPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Tasbeeh\Views\TasbeehPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

<ItemGroup><Compile Remove="tests\**\*.cs;obj\**\*.cs;bin\**\*.cs" /><None Remove="tests\**" /></ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <MauiXaml Remove="AppShell.xaml" />
  </ItemGroup>
  <!-- Xcode 26.3 ships the iOS 26.2 SDK. Limit this workaround to local Debug builds. -->
  <Target Name="AllowXcode263WithIos262ForDebug"
          BeforeTargets="_ValidateXcodeVersion"
          Condition="'$(Configuration)' == 'Debug' and '$(TargetFramework)' == 'net10.0-ios' and '$(_ShortPackageVersion)' == '26.2.10197' and '$(_XcodeVersion)' == '26.3'">
    <PropertyGroup>
      <_IsMatchingXcode>true</_IsMatchingXcode>
    </PropertyGroup>
  </Target>
</Project>
